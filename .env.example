# ============================================================
# 投资 X Buddy · 环境变量样例（只含占位符，真实密钥严禁写进本文件）
# 复制为 .env 后按需填写；.env 已在 .gitignore 中排除。
# ============================================================

# --- 数据源（扶摇）---
FUYAO_BASE_URL=https://fuyao.aicubes.cn
# 可选。留空时会尝试读取本地 api-key.txt（无则自动降级为 MOCK_DATA_MODE，不会启动即崩）
FUYAO_API_KEY=
FUYAO_TIMEOUT_MS=8000

# --- 存储 ---
DATABASE_URL=sqlite:///./data/buddy.db

# --- 降级备源（iFinD MCP，M2；默认启用但仅作备源，缺 ENDPOINT/KEY 时自动降级为 NotEnabled）---
IFIND_MCP_ENABLED=true
IFIND_MCP_ENDPOINT=https://api-mcp.51ifind.com:8643/ds-mcp-servers/hexin-ifind-ds-news-mcp
# 可选。iFinD 鉴权为裸 token（无 Bearer 前缀），严禁写进本文件
IFIND_MCP_KEY=

# --- 数据工具（M2）---
# 工具结果 TTL 缓存秒数（架构 §9.3 第 ④ 步；降级时可返回「缓存 + 过期标注」）
CACHE_TTL_S=60

# --- 模型（M1；缺失时 ModelRouter 降级而非崩，见 03_BUILD_PLAN §3 M1）---
LLM_PROVIDER_PRIMARY=openai-compatible
LLM_BASE_URL_PRIMARY=
# 可选。留空时所有角色调用返回 DEGRADED，上层走「降级研判」路径（不得启动即崩）
LLM_API_KEY_PRIMARY=
LLM_MODEL_PRIMARY=
# 轻任务档位（Clarifier / Compactor）；留空则回落到 LLM_MODEL_PRIMARY
LLM_MODEL_SMALL=
LLM_TIMEOUT_MS=45000
LLM_MAX_FAILOVER=2
# LLM 单价（人民币 / 百万 token），用于把上游 usage 折算成 llm_calls.cost。
# 未填（0）即不做计价、成本记 0（不编造单价）；prompt tokens 一律按输入单价计（保守上界）。
LLM_PRICE_INPUT_PER_MTOK_CNY=0
LLM_PRICE_OUTPUT_PER_MTOK_CNY=0

# --- 应用 ---
APP_ENV=dev
# 真实 Key 已配置时默认走真实数据；只有明确要离线演示才改为 true。
MOCK_DATA_MODE=false
